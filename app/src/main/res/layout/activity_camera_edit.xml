<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="32dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar cámara"
            android:textSize="32sp" />

        <TextView style="@style/FieldLabel" android:text="Tipo de cámara" />
        <RadioGroup
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/typeXmeye"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/typeOnvif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp" />

            <RadioButton
                android:id="@+id/typeRtsp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp" />
        </RadioGroup>

        <TextView style="@style/FieldLabel" android:text="Nombre" />
        <EditText
            android:id="@+id/name"
            style="@style/Field"
            android:hint="Ej: Patio, Entrada, Garage"
            android:inputType="textCapSentences" />

        <TextView android:id="@+id/hostLabel" style="@style/FieldLabel" android:text="Dirección IP" />
        <EditText
            android:id="@+id/host"
            style="@style/Field"
            android:digits="0123456789."
            android:hint="192.168.1.64"
            android:inputType="number|numberDecimal" />

        <TextView android:id="@+id/portLabel" style="@style/FieldLabel" android:text="Puerto" />
        <EditText
            android:id="@+id/port"
            style="@style/Field"
            android:inputType="number" />

        <TextView android:id="@+id/urlLabel" style="@style/FieldLabel" android:text="URL RTSP" />
        <EditText
            android:id="@+id/url"
            style="@style/Field"
            android:hint="rtsp://192.168.1.64:554/Streaming/Channels/101"
            android:inputType="textUri" />
        <TextView
            android:id="@+id/urlHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:text="Ejemplos — Hikvision: /Streaming/Channels/101 · Dahua/Imou: /cam/realmonitor?channel=1&amp;subtype=0 · Tapo: /stream1 · Reolink: /h264Preview_01_main"
            android:textSize="14sp" />

        <TextView style="@style/FieldLabel" android:text="Usuario" />
        <EditText
            android:id="@+id/user"
            style="@style/Field"
            android:inputType="text" />

        <TextView style="@style/FieldLabel" android:text="Contraseña" />
        <EditText
            android:id="@+id/password"
            style="@style/Field"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Probar conexión" />

            <Button
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Guardar" />

            <Button
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Cancelar" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
